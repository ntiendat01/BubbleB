<?xml version="1.0" encoding="utf-8"?>
<!-- HTTPS only: no cleartext exceptions, system trust anchors only (SECURITY_PRIVACY.md §6, §9). -->
<network-security-config>
    <base-config cleartextTrafficPermitted="false">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>
